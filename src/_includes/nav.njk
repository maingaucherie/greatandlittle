{#
  nav.njk — the header on every page except the homepage.

  This is deliberately not a small copy of the homepage scale bar. That bar
  works because of its ticks, bands, end captions and lens; shrink it to a
  strip and all of that goes, leaving unlabelled dots close enough to
  collide. So instead of a map, the header is a statement of position:

    Great & Little            ← Microscopy   THE BENCH 10⁻⁰·⁹ m   Telescopy →

  The wordmark goes home. The middle says where you are and, more usefully,
  how big that is — which is the site's whole premise, repeated on every
  page rather than only on the front one. Either side are the next sections
  up and down the scale, so the site can be walked in order.

  Order and names come from _data/sections.json; switches from
  _data/options.json under "nav". Neither needs editing to add a section.
#}
{% if options.nav.show %}
{%- set here = sections.list | scaleNeighbours(current) -%}
<header class="sitenav{% if options.nav.sticky %} is-sticky{% endif %}">
  <div class="sitenav-inner">

    {# Wordmark, doubles as the home link. #}
    <a class="sitenav-mark" href="/">Great <span class="amp">&amp;</span> Little</a>

    {% if here.current %}
    <nav class="sitenav-where" aria-label="Sections, smallest to largest">

      {% if options.nav.showNeighbours and here.smaller %}
      <a class="sitenav-step" href="/{{ here.smaller.key }}/" rel="prev">
        <span aria-hidden="true">&#8592;</span>
        <span class="sitenav-step-name">{{ here.smaller.name }}</span>
      </a>
      {% endif %}

      {# On a section's own page this is just a label. On a post inside that
         section it becomes the way back up to it. #}
      <span class="sitenav-here{% if here.current.zone %} off{% endif %}">
        {%- if page.url == "/" + here.current.key + "/" %}
        <span class="sitenav-here-name" aria-current="page">{{ here.current.name }}</span>
        {%- else %}
        <a class="sitenav-here-name" href="/{{ here.current.key }}/">{{ here.current.name }}</a>
        {%- endif %}
        <span class="sitenav-here-scale">
          {%- if here.current.zone %}off scale{% else %}{{ here.current.at | expLabel }}{% endif -%}
        </span>
      </span>

      {% if options.nav.showNeighbours and here.larger %}
      <a class="sitenav-step" href="/{{ here.larger.key }}/" rel="next">
        <span class="sitenav-step-name">{{ here.larger.name }}</span>
        <span aria-hidden="true">&#8594;</span>
      </a>
      {% endif %}

    </nav>
    {% endif %}

  </div>

</header>
{% endif %}
