{#
  base.njk — the shell every page is wrapped in.

  Handles <head>, fonts, the persistent nav, and the footer. Whatever the
  page provides becomes {{ content }} in the middle.

  Front matter a page can set:
    title        used in the browser tab
    description  the meta description
    wide         true to start content at the top instead of centring it
    current      which section key to highlight in the nav
    hideNav      true to suppress the nav on this page only
#}
{%- set face = fonts[options.typography.display] or fonts["Fraunces"] -%}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>{% if title and title != site.title %}{{ title }} — {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
<meta name="description" content="{{ description or summary or site.tagline }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">

{# What Slack, Discord, WhatsApp and the rest show when someone shares a
   page: a title, a line of description, and a picture. Without these, a link
   to a review arrives as a bare blue URL — a waste for a site this visual.
   The picture is the entry's own cover art, falling back to whatever is set
   as the site-wide share image under Settings > Site details. #}
{%- set shareSource = cover or site.shareImage %}
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:type" content="{% if date %}article{% else %}website{% endif %}">
<meta property="og:title" content="{% if title and title != site.title %}{{ title }}{% else %}{{ site.title }}{% endif %}">
<meta property="og:description" content="{{ description or summary or site.tagline }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
{%- if shareSource %}
<meta property="og:image" content="{{ site.url }}{{ shareSource | shareImage }}">
<meta property="og:image:alt" content="{{ coverAlt or title or site.title }}">
<meta name="twitter:card" content="summary_large_image">
{%- else %}
<meta name="twitter:card" content="summary">
{%- endif %}

{# Favicons. The SVG is what modern browsers use; the .ico is a fallback
   for older ones. Both live at the site root. #}
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">

{# Fonts. The display face is chosen in the CMS under Settings > Appearance;
   its Google Fonts query comes from src/_data/fonts.json. Body and mono are
   fixed — IBM Plex does unglamorous work well and swapping it rarely helps. #}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family={{ face.query }}&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500&display=swap" rel="stylesheet">

<link rel="stylesheet" href="/style.css">

{# Fonts and colours, written in as CSS variables that override the
   fallbacks at the top of style.css. The loop takes whatever is in the
   theme block of site.json, so adding a colour there (and to the CMS)
   needs no edit here. A blank field is skipped and the style.css value
   takes over, which is why clearing one in the CMS is safe. #}
<style>
  :root{
    --font-display:{{ face.stack | safe }};
    --font-axes:{{ (face.axes or "'wght' 400") | safe }};
    --display-scale:{{ options.typography.displayScale or 1 }};
    {%- for name, value in site.theme %}{% if value and name[0] != "_" %}
    {{ name | cssVar }}:{{ value }};
    {%- endif %}{% endfor %}
    {%- if site.theme.brass %}
    {# The hover wash is the accent at 9%, worked out here rather than
       typed in as a second colour that could drift out of step. #}
    --brass-wash:color-mix(in srgb, {{ site.theme.brass }} 9%, transparent);
    {%- endif %}
  }
</style>

{% if options.entries.showFeed %}<link rel="alternate" type="application/atom+xml" href="/feed.xml" title="{{ site.title }}">{% endif %}
{% if not options.motion.enabled %}<style>*,*::before,*::after{animation:none !important;transition:none !important;}</style>{% endif %}
</head>
<body>

{# The compact scale bar header. Suppressed on the homepage by default,
   since the full-size bar is right there — flip options.nav.showOnHome
   to true if you want it in both places. #}
{% if not hideNav and (options.nav.showOnHome or not isHome) %}
  {% include "nav.njk" %}
{% endif %}

<div class="wrap{% if wide %} wrap-top{% endif %}">
{{ content | safe }}
</div>

<footer>
  <span class="status">{{ site.status }}</span>
  <span>{{ site.place }}</span>
</footer>

</body>
</html>
