{#
  scalebar.njk — the full-size navigation on the homepage.

  Three regions across one row:

    [ Discrete ] ⁄⁄ [ ————— ruled bar ————— ] ⁄⁄ [ Unbound ]

  The middle is the measurable world, ruled in metres and warped by the
  fisheye. The two ends are off-scale parking for things that have no size:
  code and simulation on the left (below resolution), ideas and philosophy
  on the right (beyond bound).

  Everything about the end zones says "not on the scale": no tick marks,
  a dashed baseline instead of a solid one, purple instead of brass, a
  break mark where the axis stops, and a different pin shape — squares on
  the left, triangles on the right, circles only on the ruled bar.

  Data:
    _data/sections.json  markers; a "zone" of discrete or unbound moves one off-scale
    _data/scale.json     bands, lens settings, zone names
#}
{%- set span = scale.high - scale.low -%}
{%- set onBar = sections.list | visible | inZone -%}
{%- set inL = sections.list | visible | inZone("discrete") -%}
{%- set inR = sections.list | visible | inZone("unbound") -%}
{%- set useZones = scale.zones.show and (inL.length or inR.length) -%}

<section class="scale{% if useZones %} has-zones{% endif %}" id="scale">
  <p class="scale-caption">Scale bar</p>

  <div class="scale-row">

    {% if useZones %}
    {# ---- left zone: no size at all, below resolution ---- #}
    <div class="zone zone-l">
      <div class="zone-rail">
        {% for s in inL %}
        <a class="marker off square" href="/{{ s.key }}/" data-key="{{ s.key }}"
           data-note="{{ s.intro }}"
           style="left:{{ (loop.index / (inL.length + 1) * 100) | round(2) }}%">
          <span class="flag">{{ s.name }}</span><span class="dot"></span><span class="stem"></span>
        </a>
        {% endfor %}
      </div>
    </div>
    <span class="axis-break" aria-hidden="true">⁄⁄</span>
    {% endif %}

    {# ---- the ruled bar ---- #}
    <div class="rail" id="rail">
      <div class="ticks" aria-hidden="true">
        {%- for i in range(0, span + 1) -%}
        <i class="tick{% if i % 6 == 0 %} major{% endif %}" data-e="{{ scale.low + i }}"
           style="--x:{{ (i / span * 100) | round(3) }}%"></i>
        {%- endfor -%}
      </div>
      <nav class="markers" aria-label="Sections">
        {% for s in onBar %}
        <a class="marker" href="/{{ s.key }}/"
           style="--x:{{ s.at | atToPercent(scale.low, scale.high) }}"
           data-key="{{ s.key }}" data-at="{{ s.at }}" data-note="{{ s.intro }}">
          <span class="flag">{{ s.name }}</span><span class="dot"></span><span class="stem"></span>
        </a>
        {% endfor %}
      </nav>
    </div>

    {% if useZones %}
    <span class="axis-break" aria-hidden="true">⁄⁄</span>
    {# ---- right zone: no largest size, beyond bound ---- #}
    <div class="zone zone-r">
      <div class="zone-rail">
        {% for s in inR %}
        <a class="marker off triangle" href="/{{ s.key }}/" data-key="{{ s.key }}"
           data-note="{{ s.intro }}"
           style="left:{{ (loop.index / (inR.length + 1) * 100) | round(2) }}%">
          <span class="flag">{{ s.name }}</span><span class="dot"></span><span class="stem"></span>
        </a>
        {% endfor %}
      </div>
    </div>
    {% endif %}
  </div>

  {# ---- the band strip, in the same three regions ---- #}
  <div class="band-row" aria-hidden="true">
    {% if useZones %}
    <div class="zone-band zone-l"><span class="zone-label">{{ scale.zones.discrete.name }}</span></div>
    <span class="axis-break-spacer"></span>
    {% endif %}

    <div class="bands" id="bands">
      {%- for b in scale.bands -%}
      <span class="band" data-from="{{ b.from }}" data-to="{{ b.to }}"
            style="--from:{{ ((b.from - scale.low) / span * 100) | round(3) }}%;
                   --w:{{ ((b.to - b.from) / span * 100) | round(3) }}%;
                   --weight:{{ b.weight }}"
            {% if b.weight > 0.42 %}data-dark{% endif %}>
        <span class="band-label">{{ b.name }}</span>
      </span>
      {%- endfor -%}
    </div>

    {% if useZones %}
    <span class="axis-break-spacer"></span>
    <div class="zone-band zone-r"><span class="zone-label">{{ scale.zones.unbound.name }}</span></div>
    {% endif %}
  </div>

  {% if options.home.showRailCaptions %}
  <div class="rail-ends">
    <span>{% if useZones %}{{ scale.zones.discrete.caption }}{% else %}{{ site.railLeft }}{% endif %}</span>
    <span class="rail-readout" id="readout">{{ site.railLeft }} — {{ site.railRight }}</span>
    <span>{% if useZones %}{{ scale.zones.unbound.caption }}{% else %}{{ site.railRight }}{% endif %}</span>
  </div>
  {% endif %}

  <ul class="sections">
    {% for s in sections.list | visible %}
    <li><a href="/{{ s.key }}/" data-key="{{ s.key }}">
      <span class="exp">{% if s.zone %}off scale{% else %}{{ s.at | expLabel }}{% endif %}</span>
      <span class="name">{{ s.name }}</span>
      <span class="blurb">{{ s.blurb }}</span>
    </a></li>
    {% endfor %}
  </ul>
</section>

<script>
(function () {
  "use strict";

  var LOW = {{ scale.low }}, HIGH = {{ scale.high }};
  var SIG = {{ scale.lens.width }};        // lens width, in decades
  var AMP = {{ scale.lens.strength }};     // peak magnification
  var SNAP = {{ scale.lens.snap }};        // px within which a marker grabs the lens
  var ON = {{ "true" if (scale.lens.enabled and options.motion.enabled) else "false" }};
  var REST = {{ (site.railLeft + " — " + site.railRight) | dump | safe }};

  var scale = document.getElementById('scale');
  var rail = document.getElementById('rail');
  var bands = document.getElementById('bands');
  var readout = document.getElementById('readout');
  if (!scale || !rail) return;

  var ticks = [].slice.call(rail.querySelectorAll('.tick'));
  var marks = [].slice.call(rail.querySelectorAll('.marker'));
  var bandEls = bands ? [].slice.call(bands.querySelectorAll('.band')) : [];

  // Off-scale markers live outside the rail, so the lens never touches them.
  // They still drive the readout.
  var offs = [].slice.call(scale.querySelectorAll('.marker.off'));
  offs.forEach(function (m) {
    m.addEventListener('mouseenter', function () {
      if (readout) { readout.textContent = m.dataset.note || m.querySelector('.flag').textContent; readout.classList.add('on'); }
    });
    m.addEventListener('focus', function () {
      if (readout) { readout.textContent = m.dataset.note || m.querySelector('.flag').textContent; readout.classList.add('on'); }
    });
  });

  var still = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!ON || still) return;

  var SPAN = HIGH - LOW;
  marks.forEach(function (m) { m._e = parseFloat(m.dataset.at); });
  ticks.forEach(function (t) { t._e = parseFloat(t.dataset.e); });
  bandEls.forEach(function (b) {
    b._a = parseFloat(b.dataset.from);
    b._b = parseFloat(b.dataset.to);
    b._lw = b.querySelector('.band-label').scrollWidth;
  });

  scale.classList.add('is-warped');

  // Magnification is a Gaussian bump centred at curF. The two mirror terms
  // reflect the part of the bump falling outside the domain back inside, so
  // the area under the curve stays constant wherever the lens sits — without
  // them the bar visibly stretches near its own edges.
  var N = 181, dE = SPAN / N, cum = new Float64Array(N + 1);
  var curF = 0, tgtF = 0, curA = 0, tgtA = 0, W = 0, raf = 0, lock = -1;

  function g(z) { return Math.exp(-z * z); }
  function dens(e) {
    var m1 = 2 * LOW - curF, m2 = 2 * HIGH - curF;
    return 1 + curA * AMP * (g((e - curF) / SIG) + g((e - m1) / SIG) + g((e - m2) / SIG));
  }
  function build() {
    var s = 0, i;
    cum[0] = 0;
    for (i = 0; i < N; i++) { s += dens(LOW + (i + 0.5) * dE) * dE; cum[i + 1] = s; }
    var k = W / s;
    for (i = 0; i <= N; i++) cum[i] *= k;
  }
  function map(e) {
    var t = (e - LOW) / dE, i = Math.max(0, Math.min(N - 1, Math.floor(t)));
    return cum[i] + (cum[i + 1] - cum[i]) * (t - i);
  }
  function unmap(x) {
    var i = 0;
    while (i < N && cum[i + 1] < x) i++;
    var d = cum[i + 1] - cum[i];
    return LOW + dE * (i + (d ? (x - cum[i]) / d : 0));
  }
  function sup(n) {
    var m = { '-': '\u207B', '0': '\u2070', '1': '\u00B9', '2': '\u00B2', '3': '\u00B3',
              '4': '\u2074', '5': '\u2075', '6': '\u2076', '7': '\u2077', '8': '\u2078', '9': '\u2079' };
    return String(n).split('').map(function (c) { return m[c] || c; }).join('');
  }

  function draw() {
    build();
    ticks.forEach(function (t) { t.style.transform = 'translateX(' + map(t._e) + 'px)'; });
    marks.forEach(function (m, i) {
      m.style.transform = 'translateX(' + map(m._e) + 'px)';
      m.classList.toggle('is-locked', lock === i);
    });
    bandEls.forEach(function (b) {
      var l = map(b._a), w = map(b._b) - l;
      b.style.transform = 'translateX(' + l + 'px)';
      b.style.width = Math.max(0, w - 2) + 'px';
      b.classList.toggle('fits', curA > 0.3 && w > b._lw + 14);
    });
  }
  function frame() {
    curF += (tgtF - curF) * 0.22;
    curA += (tgtA - curA) * 0.16;
    draw();
    raf = (Math.abs(tgtF - curF) > 0.004 || Math.abs(tgtA - curA) > 0.004)
      ? requestAnimationFrame(frame) : 0;
  }
  function go() { if (!raf) raf = requestAnimationFrame(frame); }
  function size() { W = rail.clientWidth; draw(); }

  function focusAt(x) {
    // Markers are magnetic: inside SNAP pixels the lens locks on and stops
    // following the pointer, so the link holds still long enough to click.
    var best = -1, bb = 1e9;
    marks.forEach(function (m, i) {
      var d = Math.abs(map(m._e) - x);
      if (d < bb) { bb = d; best = i; }
    });
    if (bb < SNAP) {
      lock = best;
      tgtF = marks[best]._e;
      if (readout) readout.textContent = marks[best].dataset.note || marks[best].querySelector('.flag').textContent;
    } else {
      lock = -1;
      tgtF = unmap(x);
      var b = bandEls.filter(function (x2) { return tgtF >= x2._a && tgtF <= x2._b; })[0];
      if (readout && b) {
        readout.textContent = b.querySelector('.band-label').textContent
          + ' \u00B7 10' + sup(b._a) + '\u2013' + '10' + sup(b._b) + ' m';
      }
    }
    if (readout) readout.classList.add('on');
    go();
  }

  rail.addEventListener('mousemove', function (e) {
    var r = rail.getBoundingClientRect();
    focusAt(Math.max(0, Math.min(W, e.clientX - r.left)));
  });
  rail.addEventListener('mouseenter', function () { tgtA = 1; scale.classList.add('is-open'); go(); });
  scale.addEventListener('mouseenter', function () { scale.classList.add('is-open'); });
  scale.addEventListener('mouseleave', function () {
    tgtA = 0; lock = -1;
    scale.classList.remove('is-open');
    if (readout) { readout.classList.remove('on'); readout.textContent = REST; }
    go();
  });

  marks.forEach(function (m, i) {
    m.addEventListener('focus', function () {
      tgtA = 1; lock = i; tgtF = m._e;
      scale.classList.add('is-open');
      if (readout) { readout.textContent = m.dataset.note || m.querySelector('.flag').textContent; readout.classList.add('on'); }
      go();
    });
    m.addEventListener('blur', function () {
      if (!scale.matches(':hover')) { tgtA = 0; lock = -1; scale.classList.remove('is-open'); }
      go();
    });
  });

  rail.addEventListener('touchstart', function (e) {
    var r = rail.getBoundingClientRect();
    tgtA = 1; scale.classList.add('is-open');
    focusAt(Math.max(0, Math.min(W, e.touches[0].clientX - r.left)));
  }, { passive: true });

  requestAnimationFrame(size);
  window.addEventListener('resize', size);
})();
</script>

{# Cross-highlighting between the bar and the section list below. #}
<script>
  (function () {
    var link = function (key, on) {
      var all = document.querySelectorAll('[data-key="' + key + '"]');
      for (var i = 0; i < all.length; i++) all[i].classList.toggle('is-active', on);
    };
    var els = document.querySelectorAll('[data-key]');
    for (var i = 0; i < els.length; i++) (function (el) {
      var key = el.dataset.key;
      ['mouseenter', 'focus'].forEach(function (e) { el.addEventListener(e, function () { link(key, true); }); });
      ['mouseleave', 'blur'].forEach(function (e) { el.addEventListener(e, function () { link(key, false); }); });
    })(els[i]);
  })();
</script>
