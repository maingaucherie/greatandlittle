{#
  scalebar.njk — the full-size navigation on the homepage.

  Three regions across one row:

    [ Discrete ] ⁄⁄ [ ————— ruled bar ————— ] ⁄⁄ [ Unbound ]

  The middle is the measurable world, ruled in metres and warped by the
  fisheye. The two ends are off-scale parking for things that have no size:
  code and simulation on the left (below resolution), ideas and philosophy
  on the right (beyond bound).

  Everything about the end zones says "not on the scale": no tick marks,
  a dashed baseline instead of a solid one, purple instead of brass, a
  break mark where the axis stops, and a different pin shape — squares on
  the left, triangles on the right, circles only on the ruled bar.

  Data:
    _data/sections.json  markers; a "zone" of discrete or unbound moves one off-scale
    _data/scale.json     bands, lens settings, zone names
#}
{%- set span = scale.high - scale.low -%}
{%- set onBar = sections.list | visible | inZone -%}
{%- set inL = sections.list | visible | inZone("discrete") -%}
{%- set inR = sections.list | visible | inZone("unbound") -%}
{%- set useZones = scale.zones.show and (inL.length or inR.length) -%}

<section class="scale{% if useZones %} has-zones{% endif %}" id="scale">
  <p class="scale-caption">Scale bar</p>

  <div class="scale-row">

    {% if useZones %}
    {# ---- left zone: no size at all, below resolution ---- #}
    <div class="zone zone-l">
      <div class="zone-rail">
        {% for s in inL %}
        <a class="marker off square" href="/{{ s.key }}/" data-key="{{ s.key }}"
           data-note="{{ s.intro }}"
           style="left:{{ (loop.index / (inL.length + 1) * 100) | round(2) }}%">
          <span class="flag">{{ s.name }}</span><span class="dot"></span><span class="stem"></span>
        </a>
        {% endfor %}
      </div>
    </div>
    <span class="axis-break" aria-hidden="true">⁄⁄</span>
    {% endif %}

    {# ---- the ruled bar ----
       One tick per decade, every sixth one taller. The ticks are the decades,
       which is why there's no setting for how many to draw. #}
    <div class="rail" id="rail">
      <div class="ticks" aria-hidden="true">
        {%- for i in range(0, span + 1) -%}
        <i class="tick{% if i % 6 == 0 %} major{% endif %}" data-e="{{ scale.low + i }}"
           style="--x:{{ (i / span * 100) | round(3) }}%"></i>
        {%- endfor -%}
      </div>
      <nav class="markers" aria-label="Sections">
        {% for s in onBar %}
        <a class="marker" href="/{{ s.key }}/"
           style="--x:{{ s.at | atToPercent(scale.low, scale.high) }}"
           data-key="{{ s.key }}" data-at="{{ s.at }}" data-note="{{ s.intro }}">
          <span class="flag">{{ s.name }}</span><span class="dot"></span><span class="stem"></span>
        </a>
        {% endfor %}
      </nav>
    </div>

    {% if useZones %}
    <span class="axis-break" aria-hidden="true">⁄⁄</span>
    {# ---- right zone: no largest size, beyond bound ---- #}
    <div class="zone zone-r">
      <div class="zone-rail">
        {% for s in inR %}
        <a class="marker off triangle" href="/{{ s.key }}/" data-key="{{ s.key }}"
           data-note="{{ s.intro }}"
           style="left:{{ (loop.index / (inR.length + 1) * 100) | round(2) }}%">
          <span class="flag">{{ s.name }}</span><span class="dot"></span><span class="stem"></span>
        </a>
        {% endfor %}
      </div>
    </div>
    {% endif %}
  </div>

  {# ---- the band strip, in the same three regions ---- #}
  <div class="band-row" aria-hidden="true">
    {% if useZones %}
    <div class="zone-band zone-l"><span class="zone-label">{{ scale.zones.discrete.name }}</span></div>
    <span class="axis-break-spacer"></span>
    {% endif %}

    <div class="bands" id="bands">
      {%- for b in scale.bands -%}
      <span class="band" data-from="{{ b.from }}" data-to="{{ b.to }}"
            style="--from:{{ ((b.from - scale.low) / span * 100) | round(3) }}%;
                   --w:{{ ((b.to - b.from) / span * 100) | round(3) }}%;
                   --weight:{{ b.weight }}"
            {% if b.weight > 0.42 %}data-dark{% endif %}>
        <span class="band-label">{{ b.name }}</span>
      </span>
      {%- endfor -%}
    </div>

    {% if useZones %}
    <span class="axis-break-spacer"></span>
    <div class="zone-band zone-r"><span class="zone-label">{{ scale.zones.unbound.name }}</span></div>
    {% endif %}
  </div>

  {% if options.home.showRailCaptions %}
  <div class="rail-ends">
    <span>{% if useZones %}{{ scale.zones.discrete.caption }}{% else %}{{ site.railLeft }}{% endif %}</span>
    <span class="rail-readout" id="readout">{{ site.railLeft }} — {{ site.railRight }}</span>
    <span>{% if useZones %}{{ scale.zones.unbound.caption }}{% else %}{{ site.railRight }}{% endif %}</span>
  </div>
  {% endif %}

  <ul class="sections">
    {% for s in sections.list | visible %}
    <li><a href="/{{ s.key }}/" data-key="{{ s.key }}">
      <span class="exp">{% if s.zone %}off scale{% else %}{{ s.at | expLabel }}{% endif %}</span>
      <span class="name">{{ s.name }}</span>
      <span class="blurb">{{ s.blurb }}</span>
    </a></li>
    {% endfor %}
  </ul>
</section>

<script>
/*
  The fisheye.

  The bar covers 36 decades in about 900 pixels, so at rest each decade gets
  25 pixels and the busy stretches are unreadable. Hovering magnifies the
  decades under the pointer and squeezes the rest to make room, which keeps
  the bar exactly as wide as it was.

  How it works, in one go: give every point on the bar a "stretch" value —
  1 normally, more where the lens is — then chop the bar into 180 thin
  slices, give each slice a share of the width proportional to its stretch,
  and add those widths up from the left. The running total answers the only
  question anything here asks: where does 10^N sit on screen right now.
  Ticks, markers and bands all go through that same answer, which is why
  they warp together instead of sliding apart.
*/
(function () {

  // --- The knobs, all of them from the CMS ---------------------------------
  const lowestExponent  = {{ scale.low }};
  const highestExponent = {{ scale.high }};
  const lensWidth       = {{ scale.lens.width }};      // spread, in decades
  const lensStrength    = {{ scale.lens.strength }};   // peak magnification
  const snapDistance    = {{ scale.lens.snap }};       // px before a marker grabs the lens
  const lensEnabled     = {{ "true" if (scale.lens.enabled and options.motion.enabled) else "false" }};
  const restingCaption  = {{ (site.railLeft + " — " + site.railRight) | dump | safe }};

  const scale   = document.getElementById('scale');
  const rail    = document.getElementById('rail');
  const bands   = document.getElementById('bands');
  const readout = document.getElementById('readout');
  if (!scale || !rail) return;

  // --- The readout, the line of text under the bar -------------------------
  function showInReadout(text) {
    if (!readout) return;
    readout.textContent = text;
    readout.classList.add('on');
  }

  function clearReadout() {
    if (!readout) return;
    readout.textContent = restingCaption;
    readout.classList.remove('on');
  }

  // Off-scale markers sit outside the rail, so the lens never reaches them.
  // They still name themselves in the readout when you hover or tab to one.
  for (const el of scale.querySelectorAll('.marker.off')) {
    const note = el.dataset.note || el.querySelector('.flag').textContent;
    el.addEventListener('mouseenter', () => showInReadout(note));
    el.addEventListener('focus', () => showInReadout(note));
  }

  // Everything past this point is the lens. With it turned off in the CMS,
  // or for a visitor who has asked for less movement, the bar stays plainly
  // linear — every link on it works exactly the same either way.
  const prefersStillness =
    window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!lensEnabled || prefersStillness) return;

  scale.classList.add('is-warped');

  // --- What there is to move ----------------------------------------------
  // Each one's exponent is read out of the DOM once, here, rather than on
  // every frame.
  const ticks = [...rail.querySelectorAll('.tick')].map((el) => ({
    el,
    exponent: Number(el.dataset.e),
  }));

  const markers = [...rail.querySelectorAll('.marker')].map((el) => ({
    el,
    exponent: Number(el.dataset.at),
    note: el.dataset.note || el.querySelector('.flag').textContent,
  }));

  const sizeBands = !bands ? [] : [...bands.querySelectorAll('.band')].map((el) => ({
    el,
    from: Number(el.dataset.from),
    to: Number(el.dataset.to),
    name: el.querySelector('.band-label').textContent,
    // Measured now, while the bar is still unwarped, to decide later whether
    // a band has grown wide enough to show its name.
    labelWidth: el.querySelector('.band-label').scrollWidth,
  }));

  // --- Where the lens is ---------------------------------------------------
  // Each pair is "where it actually is" and "where it's heading". The gap
  // between the two is what there is to animate.
  let centre = 0, targetCentre = 0;    // the exponent the lens sits on
  let amount = 0, targetAmount = 0;    // 0 = flat bar, 1 = fully magnified
  let railWidth = 0;
  let animation = 0;                   // rAF handle; 0 means nothing running
  let lockedMarker = -1;               // index of the marker holding the lens

  // --- Exponents to pixels -------------------------------------------------
  const SLICES = 180;
  const decadesPerSlice = (highestExponent - lowestExponent) / SLICES;
  let edges = [];   // edges[i] = pixels from the left of the rail to slice i

  // How stretched the bar is at one exponent: a bump centred on the lens,
  // flat 1 everywhere the lens doesn't reach.
  function stretchAt(exponent) {
    function bump(bumpCentre) {
      const distance = (exponent - bumpCentre) / lensWidth;
      return Math.exp(-(distance * distance));
    }
    // Near either end half the bump would hang off the bar and be lost, and
    // the bar would look like it was shrinking. Bouncing that half back off
    // the end keeps the total stretch the same wherever the lens sits.
    return 1 + amount * lensStrength * (
      bump(centre) +
      bump(2 * lowestExponent - centre) +
      bump(2 * highestExponent - centre)
    );
  }

  // Rebuild the exponent-to-pixels table for wherever the lens is now.
  function measure() {
    edges = [0];
    let total = 0;
    for (let i = 0; i < SLICES; i++) {
      const middleOfSlice = lowestExponent + (i + 0.5) * decadesPerSlice;
      total += stretchAt(middleOfSlice) * decadesPerSlice;
      edges.push(total);
    }
    // Scale the lot so it ends exactly at the right-hand end of the rail.
    const pixelsPerUnit = railWidth / total;
    for (let i = 0; i < edges.length; i++) edges[i] *= pixelsPerUnit;
  }

  // Where 10^exponent currently sits, in pixels from the left of the rail.
  function positionOf(exponent) {
    const slice = (exponent - lowestExponent) / decadesPerSlice;
    const i = Math.max(0, Math.min(SLICES - 1, Math.floor(slice)));
    return edges[i] + (edges[i + 1] - edges[i]) * (slice - i);
  }

  // The other way round: which exponent is under a given pixel position.
  function exponentAt(x) {
    let i = 0;
    while (i < SLICES - 1 && edges[i + 1] < x) i++;
    const sliceWidth = edges[i + 1] - edges[i];
    const partWayIn = sliceWidth ? (x - edges[i]) / sliceWidth : 0;
    return lowestExponent + decadesPerSlice * (i + partWayIn);
  }

  // --- Drawing -------------------------------------------------------------
  function draw() {
    measure();

    for (const tick of ticks) {
      tick.el.style.transform = `translateX(${positionOf(tick.exponent)}px)`;
    }

    markers.forEach((marker, i) => {
      marker.el.style.transform = `translateX(${positionOf(marker.exponent)}px)`;
      marker.el.classList.toggle('is-locked', i === lockedMarker);
    });

    for (const band of sizeBands) {
      const left = positionOf(band.from);
      const width = positionOf(band.to) - left;
      band.el.style.transform = `translateX(${left}px)`;
      band.el.style.width = Math.max(0, width - 2) + 'px';
      // A band shows its name only once it's wide enough to hold it, which
      // is what gives the narrow ones something to reveal under the lens.
      band.el.classList.toggle('fits', amount > 0.3 && width > band.labelWidth + 14);
    }
  }

  // Ease towards the target rather than jumping to it: each frame closes a
  // fixed fraction of what's left, and stops once the remainder is too small
  // to see. The lens slides a little faster than it fades, hence two
  // different fractions.
  function animate() {
    centre += (targetCentre - centre) * 0.22;
    amount += (targetAmount - amount) * 0.16;
    draw();
    const arrived = Math.abs(targetCentre - centre) < 0.004
                 && Math.abs(targetAmount - amount) < 0.004;
    animation = arrived ? 0 : requestAnimationFrame(animate);
  }

  function startAnimating() {
    if (!animation) animation = requestAnimationFrame(animate);
  }

  function fitToRail() {
    railWidth = rail.clientWidth;
    draw();
  }

  // --- Pointing the lens ---------------------------------------------------
  const SUPERSCRIPT = {
    '-': '⁻', '0': '⁰', '1': '¹', '2': '²', '3': '³',
    '4': '⁴', '5': '⁵', '6': '⁶', '7': '⁷', '8': '⁸', '9': '⁹',
  };

  function superscript(n) {
    return String(n).split('').map((c) => SUPERSCRIPT[c] || c).join('');
  }

  // Markers are magnetic. Come within snapDistance and the lens locks onto
  // one and stops following the pointer, so the link underneath holds still
  // long enough to be clicked.
  function markerNear(x) {
    let closest = null;
    markers.forEach((marker, index) => {
      const distance = Math.abs(positionOf(marker.exponent) - x);
      if (!closest || distance < closest.distance) closest = { marker, index, distance };
    });
    return closest && closest.distance < snapDistance ? closest : null;
  }

  function aimAt(x) {
    const snapped = markerNear(x);
    if (snapped) {
      lockedMarker = snapped.index;
      targetCentre = snapped.marker.exponent;
      showInReadout(snapped.marker.note);
    } else {
      lockedMarker = -1;
      targetCentre = exponentAt(x);
      const band = sizeBands.find((b) => targetCentre >= b.from && targetCentre <= b.to);
      if (band) {
        showInReadout(`${band.name} · 10${superscript(band.from)}–10${superscript(band.to)} m`);
      }
    }
    if (readout) readout.classList.add('on');
    startAnimating();
  }

  function open() {
    targetAmount = 1;
    scale.classList.add('is-open');
    startAnimating();
  }

  function close() {
    targetAmount = 0;
    lockedMarker = -1;
    scale.classList.remove('is-open');
    clearReadout();
    startAnimating();
  }

  // Where along the rail a pointer or a finger landed, clamped to its ends.
  function positionInRail(clientX) {
    const box = rail.getBoundingClientRect();
    return Math.max(0, Math.min(railWidth, clientX - box.left));
  }

  // --- Events --------------------------------------------------------------
  rail.addEventListener('mousemove', (e) => aimAt(positionInRail(e.clientX)));
  rail.addEventListener('mouseenter', open);

  // The section list below the bar is inside .scale as well, so moving down
  // into it shouldn't count as leaving.
  scale.addEventListener('mouseenter', () => scale.classList.add('is-open'));
  scale.addEventListener('mouseleave', close);

  // Keyboard: tabbing onto a marker opens the lens on it, the same as hover.
  markers.forEach((marker, index) => {
    marker.el.addEventListener('focus', () => {
      lockedMarker = index;
      targetCentre = marker.exponent;
      showInReadout(marker.note);
      open();
    });
    marker.el.addEventListener('blur', () => {
      if (!scale.matches(':hover')) close();
    });
  });

  // Touch has no hover: a tap opens the lens where you touched, lifting your
  // finger closes it again. Without the touchend the bar stays magnified.
  rail.addEventListener('touchstart', (e) => {
    open();
    aimAt(positionInRail(e.touches[0].clientX));
  }, { passive: true });
  rail.addEventListener('touchend', close);

  // clientWidth means nothing until the bar has actually been laid out.
  requestAnimationFrame(fitToRail);
  window.addEventListener('resize', fitToRail);
})();
</script>

<script>
/*
  Hovering a marker on the bar lights up its row in the list below, and the
  other way round. It works off data-key, so it never needs to know what the
  sections are — put data-key="bench" on anything and it joins in.
*/
(function () {
  function highlight(key, on) {
    for (const el of document.querySelectorAll(`[data-key="${key}"]`)) {
      el.classList.toggle('is-active', on);
    }
  }

  for (const el of document.querySelectorAll('[data-key]')) {
    const key = el.dataset.key;
    el.addEventListener('mouseenter', () => highlight(key, true));
    el.addEventListener('focus', () => highlight(key, true));
    el.addEventListener('mouseleave', () => highlight(key, false));
    el.addEventListener('blur', () => highlight(key, false));
  }
})();
</script>
