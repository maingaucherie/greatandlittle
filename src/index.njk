{#
  The homepage. Masthead plus the full-size scale bar.

  The small domain line above the title is off by default now; turn it back
  on with options.home.showEyebrow in src/_data/options.json.
#}
<header class="masthead">
  {% if options.home.showEyebrow %}<p class="eyebrow">{{ site.domain }}</p>{% endif %}
  <h1>Great <span class="amp">&amp;</span> Little</h1>
  <p class="lede">{{ site.tagline }}</p>
</header>

{% include "scalebar.njk" %}
