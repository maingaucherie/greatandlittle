---
# ============================================================================
# Generates one page per section, at /<key>/ — see _data/sections.json.
#
# Eleventy "pagination" here means: take the sections list, make one page
# for each item. size:1 = one section per page. The permalink turns the
# section's key into its URL.
#
# Add a section to _data/sections.json and its page appears automatically.
# ============================================================================
pagination:
  data: sections.list
  size: 1
  alias: section
permalink: "/{{ section.key }}/"
layout: base.njk
wide: true
eleventyComputed:
  current: "{{ section.key }}"
  title: "{{ section.name }}"
  description: "{{ section.intro }}"
---
<div>
  <a class="backlink" href="/"><span aria-hidden="true">&#8592;</span> Great &amp; Little</a>
  <p class="page-scale">{% if section.zone %}off scale{% else %}{{ section.at | expLabel }}{% endif %}{% if section.hidden %} · unlisted{% endif %}</p>
  <h1 class="page-title">{{ section.name }}</h1>
  <p class="lede">{{ section.intro }}</p>

  {% if section.simulation %}
  {# --- Sections flagged "simulation" get an embed above their post list.
         Everything here is optional and only renders once the matching URL
         exists in _data/sections.json, so a section that isn't ready yet
         shows nothing rather than a placeholder or a dead button. --- #}
    {% if section.embedUrl %}
    <div class="stage">
      <iframe src="{{ section.embedUrl }}" title="{{ section.name }}" loading="lazy"></iframe>
    </div>
    <p class="stage-note">Runs in the browser. Expect a few seconds to load and fewer generations per second than a local copy.</p>
    {% endif %}

    {% if section.downloadUrl or section.sourceUrl %}
    <div class="actions">
      {% if section.downloadUrl %}<a class="button" href="{{ section.downloadUrl }}">Download</a>{% endif %}
      {% if section.sourceUrl %}<a class="button quiet" href="{{ section.sourceUrl }}">Source</a>{% endif %}
    </div>
    {% endif %}
  {% endif %}

  {% if section.reviews %}
    {# --- On Screen lists reviews, which carry scores --- #}
    {% set entries = collections.reviews %}
    {% if entries.length %}
    <ul class="entries">
      {% for entry in entries %}
      <li><a href="{{ entry.url }}">
        <span class="entry-score">{{ entry.data.scores | meanScore }}</span>
        <span class="entry-title">{{ entry.data.title }}</span>
        <span class="entry-meta">
          <time datetime="{{ entry.data.date | isoDate }}">{{ entry.data.date | readableDate }}</time>
          {% if entry.data.instrument %} · {{ entry.data.instrument }}{% endif %}
        </span>

        {# Three miniature score bars, one per axis, in rubric order. The
           shape of a row is recognisable at a glance — a flat 8/8/8 reads
           very differently from a 9/3/1 — so the archive can be scanned by
           the character of the verdict rather than by title. #}
        <span class="entry-bars" role="img"
              aria-label="{% for axis in rubric.axes %}{{ axis.label }} {{ entry.data.scores[axis.key] | default(0) }} out of 10. {% endfor %}">
          {%- for axis in rubric.axes -%}
          {%- set val = entry.data.scores[axis.key] -%}
          <span class="minibar" title="{{ axis.label }}">
            {%- for i in range(1, 11) -%}
            <i class="seg{% if val is defined and i <= val %} is-on{% endif %}"></i>
            {%- endfor -%}
          </span>
          {%- endfor -%}
        </span>

        {% if options.entries.showSummaries and entry.data.summary %}<span class="entry-blurb">{{ entry.data.summary }}</span>{% endif %}
      </a></li>
      {% endfor %}
    </ul>
    {% else %}
    <div class="empty"><p>Nothing published here yet.</p><p>{{ section.empty }}</p></div>
    {% endif %}

  {% else %}
    {# --- Every other section lists ordinary posts --- #}
    {% set entries = collections.posts | inSection(section.key) %}
    {% if entries.length %}
      {# Posts with a "series" value are grouped under a heading; loose
         posts fall through into a final ungrouped list. #}
      {% for group in entries | bySeries %}
        {% if group.name %}<h2 class="series-heading">{{ group.name }}</h2>{% endif %}
        <ul class="entries">
          {% for entry in group.posts %}
          {% include "entry.njk" %}
          {% endfor %}
        </ul>
      {% endfor %}
    {% else %}
    <div class="empty"><p>Nothing published here yet.</p><p>{{ section.empty }}</p></div>
    {% endif %}
  {% endif %}
</div>
