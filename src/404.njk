---
# The page Cloudflare serves for any URL that doesn't exist. Enabled by
# not_found_handling in wrangler.toml — without that line this file builds
# but never gets shown.
layout: base.njk
permalink: /404.html
eleventyExcludeFromCollections: true
title: Not found
wide: true
---
<div>
  <a class="backlink" href="/"><span aria-hidden="true">&#8592;</span> {{ site.title }}</a>
  <p class="page-scale">404 &middot; off scale</p>
  <h1 class="page-title">Believe it or not, that page isn't here</h1>
  <p class="lede verse"> Please click a section down below
  It must have been moved, or went missing I fear
  Where could it be? Believe it or not, it's not here</p>

  <ul class="entries">
    {% for s in sections.list | visible %}
    <li><a href="/{{ s.key }}/">
      <span class="entry-title">{{ s.name }}</span>
      <span class="entry-blurb">{{ s.intro }}</span>
    </a></li>
    {% endfor %}
  </ul>
</div>
