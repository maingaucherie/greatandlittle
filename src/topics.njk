---
# ============================================================================
# One page per topic tag: /topics/lamp-restoration/, etc.
# Generated from the "topics" collection in eleventy.config.js, which gathers
# every distinct value used across posts and reviews.
# ============================================================================
pagination:
  data: collections.topics
  size: 1
  alias: topic
permalink: "/topics/{{ topic.slug }}/"
layout: base.njk
wide: true
eleventyComputed:
  title: "{{ topic.name }}"
  description: "Everything tagged {{ topic.name }}."
---
<div>
  <p class="page-scale">Topic</p>
  <h1 class="page-title">{{ topic.name }}</h1>
  <p class="lede">{{ topic.count }} {% if topic.count == 1 %}entry{% else %}entries{% endif %}.</p>

  <ul class="entries">
    {% for entry in topic.entries %}
    {% include "entry.njk" %}
    {% endfor %}
  </ul>
</div>
